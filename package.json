{
  "name": "gikou-folio",
  "version": "0.1.0",
  "description": "GIKOU folio：データと本文から、読むための A4 の HTML（folio）を作る純粋な関数。ボタンを押す画面ではなく、読む 1 枚（または数枚）を返す。印刷すれば PDF。Node でも Cloudflare の Worker でも動く",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": "26"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "biome check",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "gen:css": "node scripts/gen-css.ts",
    "gen:check": "node scripts/gen-css.ts --check"
  },
  "dependencies": {
    "rehype-stringify": "^10.0.1",
    "remark-directive": "4.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
